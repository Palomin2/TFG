\PYG{c+cm}{*       vValueAt0(1) value set for the boundary condition, default is set at 0.}
\PYG{c+cm}{*Output: Modification of the sparse matrix and the linear form to keep the system as symetric as posible.}
\PYG{c+cm}{*/}\PYG{+w}{  }
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{impose\PYGZus{}Dirichlet\PYGZus{}Condition}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{size}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Eigen}\PYG{o}{::}\PYG{n}{SparseMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{global}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Eigen}\PYG{o}{::}\PYG{n}{VectorXd}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{LinearForm}\PYG{p}{,}
\PYG{+w}{         }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{Modify0}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{Modify1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{ValueAt0}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{ValueAt1}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: size=LineraForm.size()\PYGZhy{}1, LinearForm, Modify0(1) true if we have dirichlet condition at the start(end) of the boundary,}
\PYG{c+cm}{*       vValueAt0(1) value set for the boundary condition, default is set at 0.}
\PYG{c+cm}{*Output: Modification of the linear form applying the conditions to the borders.}
\PYG{c+cm}{*/}\PYG{+w}{ }
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{impose\PYGZus{}Newmann\PYGZus{}Condition}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{size}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Eigen}\PYG{o}{::}\PYG{n}{VectorXd}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{LinearForm}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{Modify0}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{bool}\PYG{+w}{ }\PYG{n}{Modify1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{ValueAt0}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{ValueAt1}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: p polinomial degree, size=LineraForm.size()\PYGZhy{}1, SparseMatrix with the system already assambled, same with the LinearForm,}
