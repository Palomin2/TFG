\PYG{c+cm}{/**************************************************************************************}
\PYG{c+cm}{ * Structure of the Data File for Matrix}
\PYG{c+cm}{ * Nrow Ncol}
\PYG{c+cm}{ * vector of size Ncol representing the first variable where elements are separated by space Ex(x1 x2 x3 ...)}
\PYG{c+cm}{ * vector of size Ncol ...}
\PYG{c+cm}{ * .}
\PYG{c+cm}{ * .  Nrow times in total}
\PYG{c+cm}{ * . }
\PYG{c+cm}{ * }
\PYG{c+cm}{ **************************************************************************************/}
\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Direction of the data file}
\PYG{c+cm}{*Output: iMatrix filled with the control points in data file}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{ReadDataFile\PYGZus{}Matrix}\PYG{p}{(}\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{direction}\PYG{p}{);}

\PYG{c+cm}{/**************************************************************************************}
\PYG{c+cm}{ * Structure of the Data File for Tensors}
\PYG{c+cm}{ * Ncol NSplits   *}
\PYG{c+cm}{ * vector of size Ncol representing the first variable where elements are separated by space Ex(x1 x2 x3 ...)}
\PYG{c+cm}{ * vector of size Ncol ...}
\PYG{c+cm}{ * .}
\PYG{c+cm}{ * .  3 times in total}
\PYG{c+cm}{ * . }
\PYG{c+cm}{ * \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{ * The previous repeated NSplits totals}
\PYG{c+cm}{ **************************************************************************************/}
\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Direction of the data file}
\PYG{c+cm}{*Output: vector of iMatrixes filled with the control points in data file}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{ReadDataFile\PYGZus{}CtrlPts}\PYG{p}{(}\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{direction}\PYG{p}{);}


\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Value of the point where the polinomial is evaluated t, and degree of the polinomial n}
\PYG{c+cm}{*Condition: t€[0,1]}
\PYG{c+cm}{*Output: Values of all the Bernstein polinomial of degree n evaluated at t}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BernsteinPolinomial}\PYG{p}{(}\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{);}


\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: iMatrix of control points and parameter of the curve t}
\PYG{c+cm}{*Conditions: t€[0,1]}
\PYG{c+cm}{*Output: Value of the Bezier curve of such control points in the point t}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BezierCurve\PYGZus{}Point\PYGZus{}t}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{PtosControl}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{);}


\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: iMatrix of control points and number of steps for the curve}
\PYG{c+cm}{*Conditions: Steps must be \PYGZgt{}= 1}
\PYG{c+cm}{*Output: Value of the Bezier curve at every point from 0 to 1 separated in N\PYGZus{}Steps steps}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BezierCurve}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{PtosControl}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{N\PYGZus{}Steps}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Tensor of control points and the 2 parameters of the curve t1, t2}
\PYG{c+cm}{*Conditions: t1,t2€[0,1]}
\PYG{c+cm}{*Output: Value of the Bezier surface at of such control points in the points t1 t2}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BezierSurface\PYGZus{}Point\PYGZus{}t1\PYGZus{}t2}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{PtosControl}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t2}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: iMatrix of control points and number of steps for the curve in both parameters}
\PYG{c+cm}{*Conditions: N\PYGZus{}Steps must be \PYGZgt{}= 1}
\PYG{c+cm}{*Output: Value of the Bezier surface at every point from 0 to 1 separated in N\PYGZus{}Steps along both parameters}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BezierSurface}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{PtosControl}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{N\PYGZus{}Steps}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Bezier surface in form of a tensor}
\PYG{c+cm}{*Output: Writes a file of 3 matrices one for each coordinate}
\PYG{c+cm}{*/}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{Write\PYGZus{}BezierSurface}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Tensor}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{name}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: CtrlPts in format described before}
\PYG{c+cm}{*Output: Writes a file of 3 matrices one for each coordinate}
\PYG{c+cm}{*/}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{Write\PYGZus{}CtrlPts}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{name}\PYG{p}{);}



\PYG{c+cm}{/************************************************************************************}
\PYG{c+cm}{*}
\PYG{c+cm}{* Classic funtions from the Nurbs Book}
\PYG{c+cm}{*}
\PYG{c+cm}{************************************************************************************/}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: A KnotVector,t the point of evalution, its polynomial degree, and n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2}
\PYG{c+cm}{*Output: the span index}
\PYG{c+cm}{*/}
\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n+nf}{FindSpan}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, p polinomial degree and KnotVector}
\PYG{c+cm}{*Output: vector of basis funcs}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{BasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, p polinomial degree and KnotVector}
\PYG{c+cm}{*Output: iMatrix where the i\PYGZhy{}th row is the i\PYGZhy{}th degree basis fun}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{AllBasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, p polinomial degree, k derivate degree, KnotVector and an output vector ders;}
\PYG{c+cm}{*Output: value of the k\PYGZhy{}derivate at point t in the ders vector on the k\PYGZhy{}row of the matrix}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{DerBasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{span}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{k}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: matrix of BasisFunctions or its derivates and the path where they will be written}
\PYG{c+cm}{*Output: Writes the Functions as a matrix on selected path}
\PYG{c+cm}{*/}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{Write\PYGZus{}BasisFunctions}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{BasisFunctions}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{name}\PYG{p}{);}

\PYG{c+cm}{/************************************************************************************}
\PYG{c+cm}{*}
\PYG{c+cm}{* Classic funtions for p spline curves/surfaces}
\PYG{c+cm}{*}
\PYG{c+cm}{************************************************************************************/}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2, p polynomial degree, KnotVector, the CtrlPts ,t the point of evalution}
\PYG{c+cm}{*Output: Evaluation of the curve at point t}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{CurvePoint}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2, p polynomial degree, KnotVector, the CtrlPts ,}
\PYG{c+cm}{*        t the point of evalution and d highest derivate order to compute}
\PYG{c+cm}{*Output: iMatrix where the i\PYGZhy{}th row is the evaluation of the i\PYGZhy{}th derivate}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{CurveDerivsAlg1}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2, p polynomial degree, KnotVector, the CtrlPts ,t the point of evalution, }
\PYG{c+cm}{*         d highest derivate order to compute, r1 and r2 specify the intervals of CtrlPoints}
\PYG{c+cm}{*Output: iMatrix where the i\PYGZhy{}th row is the vector of ctrl points}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{CurveDerivsCpts}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}
\PYG{+w}{                                             }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{r1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{r2}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2, p polynomial degree, KnotVector, the CtrlPts ,}
\PYG{c+cm}{*       t the point of evalution and d highest derivate order to compute}
\PYG{c+cm}{*Output: iMatrix where the i\PYGZhy{}th row is the evaluation of the i\PYGZhy{}th derivate}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{CurveDerivsAlg2}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Curve and path}
\PYG{c+cm}{*Output: Writes the values of the Curve in the selected path}
\PYG{c+cm}{*/}
\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{Write\PYGZus{}Curve}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Curve}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{string}\PYG{+w}{ }\PYG{n}{filename}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n\PYGZus{}i=the size of the Nurbs vector\PYGZus{}i\PYGZhy{}p\PYGZhy{}2, p\PYGZus{}i polynomial degree, KnotVector\PYGZus{}i, the CtrlPts ,t\PYGZus{}i the point of evalution}
\PYG{c+cm}{*Output: Evaluation of the surface at point (t1,t2)}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{SurfacePoint}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p1}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n2}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p2}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector2}\PYG{p}{,}
\PYG{+w}{                                 }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t2}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n\PYGZus{}i=the size of the Nurbs vector\PYGZus{}i\PYGZhy{}p\PYGZhy{}2, p\PYGZus{}i polynomial degree, KnotVector\PYGZus{}i, the CtrlPts ,}
\PYG{c+cm}{*       t\PYGZus{}i the point of evalution and d maximum order of the derivates}
\PYG{c+cm}{*Output: Evaluation of the derivates up to degree d (maximum is p or q and would overwrite it if d\PYGZgt{}p,q) in (t1,t2) where Output[k\PYGZus{}1][k\PYGZus{}2] is been}
\PYG{c+cm}{         derived k\PYGZus{}i times respect to the ith variable }
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{SurfaceDerivsAlg1}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p1}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n2}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p2}\PYG{p}{,}
\PYG{+w}{        }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector2}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t2}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{);}


\PYG{c+cm}{/************************************************************************************}
\PYG{c+cm}{*}
\PYG{c+cm}{* Classic and support funtions for NURBS curves/surfaces}
\PYG{c+cm}{*}
\PYG{c+cm}{************************************************************************************/}


\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Vector of CtrlPts and their weights at each point in a separated vector}
\PYG{c+cm}{*Output: iMatrix that each column is each of the coordinates of each CtrlPt except its last component that is it\PYGZsq{}s respective weight}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{WeightCtrlPts}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Weights}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: CtrlPts multiplied by their Weight with the respective weight at the end of each column}
\PYG{c+cm}{*Output: The original CtrlPts}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{UnWeightCtrlPts}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPtsW}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Vector of CtrlPts and their weights at each point in a separated vector}
\PYG{c+cm}{*Output: std::vector\PYGZlt{}iMatrix\PYGZlt{}double\PYGZgt{}\PYGZgt{} that keeps the format of the CtrlPts for Surface}
\PYG{c+cm}{         operations with and extra 4th dimension on each coord thats\PYGZsq{}s occupied by the weight of such pt }
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{WeightCtrlPtsSurf}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPts}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Weights}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: CtrlPts multiplied by their Weight with the respective weight at the end of each column}
\PYG{c+cm}{*Output: The original CtrlPts}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{UnWeightCtrlPtsSurf}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPtsW}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2, p polynomial degree, KnotVector, the CtrlPts weighted with theris weight in the last component ,}
\PYG{c+cm}{        t the point of evalution}
\PYG{c+cm}{*Output: Evaluation of the NURBS curve at point t}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{CurvePointRational}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPtsWeighted}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: binomial coeficients k, i}
\PYG{c+cm}{*Output: combinatiorial number given by upper number k and lower number i}
\PYG{c+cm}{*/}
\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n+nf}{Binomial}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{k}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, p polinomial degree and KnotVector, weights vector}
\PYG{c+cm}{*Output: vector of rational basis funcs}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{RationalBasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{WeightVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, k derivate degree, p polinomial degree and KnotVector, weights vector}
\PYG{c+cm}{*Output: vector of rational basis funcs}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{RatDersBasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{k}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{WeightVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, t eval point, k derivate degree, p polinomial degree and KnotVector, iMatrix of the derivates of the non\PYGZhy{}rational}
\PYG{c+cm}{*         basis funs and weights vector}
\PYG{c+cm}{*Output: vector of rational basis funcs}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{RationalizeDersBasisFuns}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{k}\PYG{p}{,}\PYG{+w}{  }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{ders}\PYG{+w}{ }\PYG{p}{,}
\PYG{+w}{         }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{WeightVector}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: Aders: derivates of the CtrlPtsWeighted using CurvDersAlg1 evaluated at some t, wders: same as Aders but with the weighted vector,}
\PYG{c+cm}{*         maximum degree of the derivate}
\PYG{c+cm}{*              \PYGZhy{}Aders = CurveDerivsAlgi(n, p,KnotVector, WeightedCtrlPts, t, d);}
\PYG{c+cm}{*              \PYGZhy{}wders = CurveDerivsAlgi(n, p,KnotVector, WeightVector, t, d);  }
\PYG{c+cm}{*Output: iMatrix on which each row is the i\PYGZhy{}th derivate of the rational curve made of the weighted CtrlPts and the weight vector}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{RatCurveDerivs}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Aders}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{wders}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: n\PYGZus{}i=the size of the Nurbs vector\PYGZus{}i\PYGZhy{}p\PYGZhy{}2, p\PYGZus{}i polynomial degree, KnotVector\PYGZus{}i, the CtrlPtsWeighted ,t\PYGZus{}i the point of evalution}
\PYG{c+cm}{*Output: Evaluation of the surface at point (t1,t2)}
\PYG{c+cm}{*/}
\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{SurfacePointRational}\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p1}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n2}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p2}\PYG{p}{,}
\PYG{+w}{        }\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector2}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPtsWeighted}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t2}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: derivates of the CtrlPtsWeighted using CurvDersAlg1 evaluated at some t, wders: same as Aders but with the weighted vector,}
\PYG{c+cm}{*         maximum degree of the derivate}
\PYG{c+cm}{*Output: iMatrix on which each row is the i\PYGZhy{}th derivate of the rational surface made of the weighted CtrlPts and the weight vector}
\PYG{c+cm}{*/}
\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{n}{RatSurfaceDerivs}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{Aders}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{wders}\PYG{p}{,}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{);}

