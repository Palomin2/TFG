\PYG{c+cm}{* Fundamental Geometric Algorithms}
\PYG{c+cm}{*}
\PYG{c+cm}{************************************************************************************/}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: KnotVector and element you want to introduce}
\PYG{c+cm}{*Output: index i such that KnotVector[i\PYGZhy{}1] \PYGZlt{}= e \PYGZlt{} KnotVector[i]}
\PYG{c+cm}{*Note: Applying insertion with this index using KnotVector.insert(KnotVector.begin()+index+1, r, e) will yield the KnotVector}
\PYG{c+cm}{*         we want (r is number of insertions)}
\PYG{c+cm}{*/}
\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n+nf}{findInsertionIndex}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{e}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: ordered vector and element you want to check it\PYGZsq{}s number of ocurrences}
\PYG{c+cm}{*Output: number of times e appears on the vector}
\PYG{c+cm}{*/}
\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n+nf}{countOccurrences}\PYG{p}{(}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{v}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{e}\PYG{p}{);}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: A KnotVector,t the point of evalution, its polynomial degree, and n=the size of the Nurbs vector\PYGZhy{}p\PYGZhy{}2}
\PYG{c+cm}{*Output: the span index at k, its multiplicity at s}
