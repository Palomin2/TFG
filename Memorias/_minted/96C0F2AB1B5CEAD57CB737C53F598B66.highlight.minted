\PYG{c+cm}{         CtrlPtsW, Knotvector, n, p}
\PYG{c+cm}{*Output: numerical value parametric space parameter such that the analytic solution of it its equal to the fisical solution at e}
\PYG{c+cm}{*/}\PYG{+w}{ }
\PYG{k+kr}{inline}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n+nf}{Fisical\PYGZus{}to\PYGZus{}Parametric}\PYG{p}{(}\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t2}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{t1}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{lowerLimit}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{Lenght}\PYG{p}{,}
\PYG{+w}{         }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{nEvals}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{iMatrix}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{CtrlPtsW}\PYG{p}{,}\PYG{k}{const}\PYG{+w}{ }\PYG{n}{std}\PYG{o}{::}\PYG{n}{vector}\PYG{o}{\PYGZlt{}}\PYG{k+kt}{double}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{KnotVector}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{)\PYGZob{}}
\PYG{+w}{        }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{IntegrateNormDer}\PYG{p}{(}\PYG{n}{t2}\PYG{p}{,}\PYG{n}{t1}\PYG{p}{,}\PYG{n}{nEvals}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{CtrlPtsW}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{KnotVector}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{n}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{p}\PYG{p}{)}\PYG{o}{/}\PYG{n}{Lenght}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}

\PYG{c+cm}{/*}
\PYG{c+cm}{*Input: i span index, p polynomial degree, k maximum derivate order, KnotVector, Intervals, nodes and weights}
