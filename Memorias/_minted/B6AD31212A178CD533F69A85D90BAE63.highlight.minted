\PYG{c+cm}{/*}
\PYG{c+cm}{void writeFunctionDers(Eigen::VectorXd funEvals,const std::vector\PYGZlt{}double\PYGZgt{} \PYGZam{}KnotVector,const iMatrix\PYGZlt{}double\PYGZgt{} \PYGZam{}CtrlPtsW ,}
\PYG{c+cm}{                       const std::vector\PYGZlt{}double\PYGZgt{} \PYGZam{}WeightVector, int n, int p, int nEvals, double lowerLimit, double upperLimit,  std::string name)\PYGZob{}}
\PYG{c+cm}{    std::ofstream fichero;}
\PYG{c+cm}{    fichero.open(name);}
\PYG{c+cm}{    Eigen::VectorXd nodes, weights;}
\PYG{c+cm}{    legendre\PYGZus{}pol(nEvals, nodes, weights);}
\PYG{c+cm}{    double auxeval1= (upperLimit \PYGZhy{} lowerLimit)/2;}
\PYG{c+cm}{    double auxeval2= (upperLimit + lowerLimit)/2;}

\PYG{c+cm}{    }
\PYG{c+cm}{    //double Step=(upperLimit\PYGZhy{}lowerLimit)/(funEvals.size()\PYGZhy{}p);}
\PYG{c+cm}{    for(unsigned int i=0; i\PYGZlt{}nEvals; i++)\PYGZob{}}
\PYG{c+cm}{        double t=auxeval1*nodes(i)+auxeval2;}
\PYG{c+cm}{        //std::cout \PYGZlt{}\PYGZlt{} \PYGZdq{}i4\PYGZdq{} \PYGZlt{}\PYGZlt{} std::endl;}
\PYG{c+cm}{        }
\PYG{c+cm}{        int span= FindSpan(KnotVector, t, p, n);}
\PYG{c+cm}{        double AuxVal=0;}
\PYG{c+cm}{        std::vector\PYGZlt{}double\PYGZgt{} eval= RatDersBasisFuns(span, t , p, 1, KnotVector, WeightVector).GetRow(1);}
\PYG{c+cm}{        for(int j=0; j\PYGZlt{}=p; j++)\PYGZob{}}
\PYG{c+cm}{            AuxVal+=funEvals[span\PYGZhy{}p+j]*eval[j];}
\PYG{c+cm}{        \PYGZcb{}}

\PYG{c+cm}{        fichero \PYGZlt{}\PYGZlt{} AuxVal \PYGZlt{}\PYGZlt{} \PYGZdq{} \PYGZdq{};}
\PYG{c+cm}{    \PYGZcb{}}
\PYG{c+cm}{    fichero.close();}
\PYG{c+cm}{\PYGZcb{}}
\PYG{c+cm}{*/}
\PYG{c+cm}{/******************************************************************************* */}

\PYG{c+cm}{/******************************************************************************* */}
\PYG{c+cm}{/*}
\PYG{c+cm}{void writeFunctionDers(std::function\PYGZlt{}double(double)\PYGZgt{} f, double lowerLimit, double upperLimit, double nEvals,const iMatrix\PYGZlt{}double\PYGZgt{} \PYGZam{}CtrlPtsW,}
\PYG{c+cm}{                        const std::vector\PYGZlt{}double\PYGZgt{} \PYGZam{}KnotVector, int n, int p, std::string name, double Lenght)\PYGZob{}}
\PYG{c+cm}{    std::ofstream fichero;}
\PYG{c+cm}{    fichero.open(name);}
\PYG{c+cm}{    Eigen::VectorXd nodes, weights;}
\PYG{c+cm}{    legendre\PYGZus{}pol(nEvals, nodes, weights);}
\PYG{c+cm}{    double auxeval1= (upperLimit \PYGZhy{} lowerLimit)/2;}
\PYG{c+cm}{    double auxeval2= (upperLimit + lowerLimit)/2;}
\PYG{c+cm}{    for(unsigned int i=0; i\PYGZlt{} nEvals; i++)\PYGZob{}}
\PYG{c+cm}{        double t= auxeval1*nodes(i)+auxeval2;}
\PYG{c+cm}{        iMatrix\PYGZlt{}double\PYGZgt{} Aders, wders;}
\PYG{c+cm}{        iMatrix\PYGZlt{}double\PYGZgt{} Allders = CurveDerivsAlg1(n, p, KnotVector, CtrlPtsW, t, 1);}
\PYG{c+cm}{        //std::cout \PYGZlt{}\PYGZlt{} \PYGZdq{}i2\PYGZdq{} \PYGZlt{}\PYGZlt{} std::endl;}
\PYG{c+cm}{        int auxInt=Allders.GetNumCols()\PYGZhy{}1;}
\PYG{c+cm}{        Aders = Allders.GetSubMat(0,1,0, auxInt\PYGZhy{}1);}
\PYG{c+cm}{        wders = Allders.GetSubMat(0,1,auxInt, auxInt);}
\PYG{c+cm}{        iMatrix\PYGZlt{}double\PYGZgt{} AuxMat2 = RatCurveDerivs(Aders, wders, 1);}
\PYG{c+cm}{        //std::cout \PYGZlt{}\PYGZlt{} \PYGZdq{}i3\PYGZdq{} \PYGZlt{}\PYGZlt{} std::endl;}

\PYG{c+cm}{        std::vector\PYGZlt{}double\PYGZgt{} AuxVec= AuxMat2.GetRow(1);}
\PYG{c+cm}{        double Jacobian=0;}
\PYG{c+cm}{        for(unsigned int i=0; i\PYGZlt{} AuxVec.size(); i++)\PYGZob{}}
\PYG{c+cm}{            Jacobian+= AuxVec[i]*AuxVec[i];}
\PYG{c+cm}{        \PYGZcb{}}
\PYG{c+cm}{        Jacobian=sqrt(Jacobian);}
\PYG{c+cm}{        //double auxVal = f(CurvePointRational(n, p, KnotVector, CtrlPtsW, t)[0])*Jacobian; //Case curve is 1 dimensional}
\PYG{c+cm}{        //std::cout \PYGZlt{}\PYGZlt{} \PYGZdq{}tders = \PYGZdq{} \PYGZlt{}\PYGZlt{} Fisical\PYGZus{}to\PYGZus{}Parametric(t, 0, Lenght, p+2, CtrlPtsW, KnotVector, n, p) \PYGZlt{}\PYGZlt{} std::endl;}
\PYG{c+cm}{        double auxVal = f(Fisical\PYGZus{}to\PYGZus{}Parametric(t, 0, Lenght, 20, CtrlPtsW, KnotVector, n, p))*Jacobian; //Generic case}

\PYG{c+cm}{        //double auxval = CurvePointRational(n, p, KnotVector, CtrlPtsW, lowerLimit + i*Step)[0];}
\PYG{c+cm}{        //std::cout \PYGZlt{}\PYGZlt{} \PYGZdq{}point is: \PYGZdq{}\PYGZlt{}\PYGZlt{} lowerLimit + (auxeval1*nodes(i)+auxeval2) \PYGZlt{}\PYGZlt{} std::endl;}

\PYG{c+cm}{        //fichero \PYGZlt{}\PYGZlt{} f(auxeval1*nodes(i)+auxeval2) \PYGZlt{}\PYGZlt{} \PYGZdq{} \PYGZdq{}; //case Jacobian is constant at value 1}
\PYG{c+cm}{        fichero \PYGZlt{}\PYGZlt{} auxVal \PYGZlt{}\PYGZlt{} \PYGZdq{} \PYGZdq{}; //case jacobian is not constant but f only takes 1 dimensional parameters}
\PYG{c+cm}{    \PYGZcb{}}

\PYG{c+cm}{    fichero.close();}
\PYG{c+cm}{\PYGZcb{}}
\PYG{c+cm}{*/}

\PYG{c+cm}{/******************************************************************************* */}

