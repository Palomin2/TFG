\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Correspondencia de las funciones de forma NURBS de la figura \ref {fig:mapping_ejemplo}. Las funciones paramétricas $\hat  {R}_{i,j}^{p,q}(u,v)$ se definen inicialmente sobre el espacio para $\hat  {\Omega }$ (izquierda). Mediante el mapeo geométrico $\mathbf  {G}$, el soporte se proyecta hacia el espacio físico $\Omega $ (derecha), dando lugar a las funciones físicas $\phi _{i,j}(x,y) = (\hat  {R}_{i,j}^{p,q} \circ \mathbf  {G}^{-1})(x,y)$.}}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:mapeo_nurbs_inverso}{{3.2}{21}{Correspondencia de las funciones de forma NURBS de la figura \ref {fig:mapping_ejemplo}. Las funciones paramétricas $\hat {R}_{i,j}^{p,q}(u,v)$ se definen inicialmente sobre el espacio para $\hat {\Omega }$ (izquierda). Mediante el mapeo geométrico $\mathbf {G}$, el soporte se proyecta hacia el espacio físico $\Omega $ (derecha), dando lugar a las funciones físicas $\phi _{i,j}(x,y) = (\hat {R}_{i,j}^{p,q} \circ \mathbf {G}^{-1})(x,y)$}{figure.caption.18}{}}
