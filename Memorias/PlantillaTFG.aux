\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Mapeo geométrico $\mathbf  {G}$ desde el dominio paramétrico $\hat  {\Omega }$ hacia el espacio físico $\Omega $. Se han empleado los siguientes parámetros: grados polinomiales $p=1$ (dirección $u$) y $q=2$ (dirección $v$); vectores de nudos $U = \{0, 0, 1, 1\}$ y $V = \{0, 0, 0, 1, 1, 1\}$; red de puntos de control $\mathbf  {P} = \{\{(1,0), (1,1), (0,1)\}, \{(3,0), (3,3), (0,3)\}\}$; y matriz de pesos $\mathbf  {W} = \{\{1, \frac  {\sqrt  {2}}{2}, 1\}, \{1, \frac  {\sqrt  {2}}{2}, 1\}\}$.}}{20}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mapping_ejemplo}{{3.1}{20}{Mapeo geométrico $\mathbf {G}$ desde el dominio paramétrico $\hat {\Omega }$ hacia el espacio físico $\Omega $. Se han empleado los siguientes parámetros: grados polinomiales $p=1$ (dirección $u$) y $q=2$ (dirección $v$); vectores de nudos $U = \{0, 0, 1, 1\}$ y $V = \{0, 0, 0, 1, 1, 1\}$; red de puntos de control $\mathbf {P} = \{\{(1,0), (1,1), (0,1)\}, \{(3,0), (3,3), (0,3)\}\}$; y matriz de pesos $\mathbf {W} = \{\{1, \frac {\sqrt {2}}{2}, 1\}, \{1, \frac {\sqrt {2}}{2}, 1\}\}$}{figure.caption.17}{}}
